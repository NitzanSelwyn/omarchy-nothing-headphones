{
  "schemaVersion": 1,
  "id": "io.github.nitzanselwyn.nothing-earbuds",
  "name": "Nothing Earbuds",
  "version": "0.3.0",
  "author": "Nitzan Selwyn",
  "license": "MIT",
  "description": "Nothing and CMF earbud battery and ANC controls in the Omarchy bar.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Nothing Earbuds",
    "description": "Connection, per-part battery and ANC controls for Nothing and CMF earbuds.",
    "category": "Audio",
    "aliases": ["nothing", "cmf", "earbuds"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "hideWhenDisconnected": false,
      "rfcommChannel": 15
    },
    "schema": [
      {
        "key": "hideWhenDisconnected",
        "type": "boolean",
        "label": "Hide when disconnected",
        "defaultValue": false
      },
      {
        "key": "rfcommChannel",
        "type": "integer",
        "label": "RFCOMM channel",
        "description": "Nothing Ear devices normally use channel 15.",
        "min": 1,
        "max": 30,
        "defaultValue": 15
      }
    ]
  }
}
